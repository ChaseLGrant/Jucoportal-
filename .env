# --- The JUCO Portal (development) ---
# SQLite for zero-config local dev. To move to Postgres/Supabase later,
# change provider in prisma/schema.prisma to "postgresql" and set this to
# your connection string, then run `npx prisma migrate deploy`.
DATABASE_URL="file:./dev.db"

# Secret used to sign session cookies. CHANGE THIS IN PRODUCTION.
AUTH_SECRET="dev-only-secret-change-me-in-production-0000000000000000"

# Public site URL (used for canonical URLs / sitemap / structured data)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
