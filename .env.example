# Postgres connection string (Supabase / Neon / Vercel Postgres / local).
# Supabase: Project Settings → Database → Connection string → URI.
DATABASE_URL="postgresql://user:password@host:5432/postgres"

# Long random string used to sign login cookies. Generate one, keep it secret.
AUTH_SECRET="replace-with-a-long-random-string"

# Your site's public URL (used for canonical URLs, sitemap, structured data).
NEXT_PUBLIC_SITE_URL="https://your-app.vercel.app"

# Secret token that protects the one-time /api/seed endpoint.
SEED_SECRET="replace-with-a-random-token"
